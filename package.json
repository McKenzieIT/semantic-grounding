{
  "name": "@deepseek-ai/dsh-semantic-layer",
  "version": "0.1.6-alpha.2",
  "description": "Host-neutral semantic grounding substrate for a text-to-SQL data agent: typed definition kinds, alias and relation graph, retrieval projection, provenance-tracked enrichment. Extracted from deepseek-harness-da.",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/McKenzieIT/semantic-grounding.git"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./llm-wiring-plugin": {
      "types": "./lib/llm-wiring-plugin.d.ts",
      "default": "./lib/llm-wiring-plugin.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/**/*.js",
    "lib/**/*.d.ts"
  ],
  "license": "MIT",
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "js-yaml": "^4.2.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@standard-schema/spec": "^1.1.0",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.20.0",
    "tsdown": "^0.22.2",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8"
  },
  "pnpm": {
    "autoInstallPeers": false
  }
}
