{
  "name": "semantic-grounding",
  "version": "0.0.0",
  "private": true,
  "description": "pnpm workspace root for @semantic-grounding/substrate and @semantic-grounding/mcp. See packages/*.",
  "type": "module",
  "scripts": {
    "build": "pnpm -r run build",
    "typecheck": "pnpm -r run typecheck",
    "test": "pnpm -r run test",
    "negation-test": "pnpm --filter @semantic-grounding/substrate run negation-test",
    "acceptance": "pnpm --filter @semantic-grounding/substrate run acceptance"
  },
  "pnpm": {
    "autoInstallPeers": false
  }
}
