{
  "name": "@semantic-grounding/mcp",
  "version": "0.0.1",
  "description": "MCP server for semantic-grounding (packages/substrate exposed to agents). Holds the git Tier-2 audit backbone (recorder, corpus lock, startup posture checks — ADR-0004, #19) and the sg-mcp stdio entry point (#22). Intent tools land in #20/#21; see map #12.",
  "private": true,
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "bin": {
    "sg-mcp": "lib/bin.js"
  },
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib/**/*.js",
    "lib/**/*.d.ts"
  ],
  "license": "MIT",
  "scripts": {
    "build": "tsdown",
    "pretypecheck": "pnpm --filter @semantic-grounding/substrate run build",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "pretest": "pnpm --filter @semantic-grounding/substrate run build",
    "test": "vitest run"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.3.1",
    "@semantic-grounding/substrate": "workspace:*",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^22.20.0",
    "tsdown": "^0.22.2",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8"
  }
}
